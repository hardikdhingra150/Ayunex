API_DOMAIN=api.your-domain.example
FRONTEND_ORIGIN=https://your-domain.example
ALLOWED_HOSTS=api.your-domain.example,127.0.0.1
CORS_ORIGINS=https://your-domain.example
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# URL-encode password characters; database and redis are compose service names.
DATABASE_URL=postgresql+psycopg://ayunex:REPLACE_WITH_RANDOM_SECRET@database:5432/ayunex
REDIS_URL=redis://:REPLACE_WITH_ANOTHER_RANDOM_SECRET@redis:6379/0
AUTH_MODE=builtin
PUBLIC_APP_URL=https://api.your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
GUIDANCE_MODE=corpus
GUIDANCE_SERVICE_URL=
GUIDANCE_SERVICE_TOKEN=
AI_PROVIDER=
AI_API_KEY=
AI_GENERATION_MODEL=
AI_EMBEDDING_MODEL=
CLOUD_PROCESSING_ALLOWED=false
OCR_ENABLED=false
OCR_LANGUAGES=eng
