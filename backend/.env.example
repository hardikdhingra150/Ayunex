# Development only. Generate your own token; do not commit it.
APP_ENV=development
AUTH_MODE=builtin
PUBLIC_APP_URL=http://127.0.0.1:8000
# Development without SMTP writes verification/reset mail to private .mail-outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
DEV_API_TOKEN=
DATABASE_URL=sqlite:///./ayunex.db
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Production: PostgreSQL, HTTPS origins, verified Module D identity; no dev token.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ayunex
IDENTITY_INTROSPECTION_URL=
IDENTITY_SERVICE_TOKEN=
GUIDANCE_SERVICE_URL=
GUIDANCE_SERVICE_TOKEN=
GUIDANCE_MODE=corpus
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RATE_LIMIT_PER_MINUTE=120
REDIS_URL=
AI_PROVIDER=
# For Groq: AI_PROVIDER=groq, AI_GENERATION_MODEL=qwen/qwen3.8-27b
# Leave AI_EMBEDDING_MODEL empty for Groq (generation with lexical retrieval).
AI_API_KEY=
AI_GENERATION_MODEL=
AI_EMBEDDING_MODEL=
CLOUD_PROCESSING_ALLOWED=false
OCR_ENABLED=false
OCR_LANGUAGES=eng
# Hosted guidance requires GUIDANCE_MODE=hosted AND request-level
# allow_hosted_processing=true. Keep keys server-side; never use VITE_ keys.
# Production settings are documented in deploy/production.env.example.
